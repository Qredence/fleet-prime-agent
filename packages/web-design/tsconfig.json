{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@prime-agent/web-design/*": ["./src/*"],
      "@prime-agent/web-protocol/*": ["../web-protocol/src/*"]
    }
  },
  "include": ["."],
  "exclude": ["node_modules", "dist"]
}
