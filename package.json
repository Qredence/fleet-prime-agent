{
	"name": "fleet-prime-agent-workspace",
	"version": "0.0.0",
	"private": true,
	"description": "Private workspace tooling for @qredence/fleet.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Qredence/fleet-prime-agent.git"
	},
	"type": "module",
	"packageManager": "pnpm@11.15.1",
	"scripts": {
		"build": "pnpm run build:web:release",
		"check": "node scripts/check.mjs",
		"check:runtime": "node scripts/check-prime-agent-runtime.mjs",
		"check:installer": "node scripts/check-source-installer.mjs --static",
		"test:source-installer": "node scripts/check-source-installer.mjs --smoke",
		"check:browser-smoke": "node scripts/check-browser-smoke.mjs",
		"format": "pnpm exec biome check --write .",
		"check:changeset": "node scripts/check-changeset.mjs",
		"check:package": "node scripts/check-package.mjs",
		"release:prepare": "node scripts/prepare-release.mjs",
		"release:publish": "node scripts/publish-release.mjs",
		"test:release": "node --test scripts/__tests__/*.test.mjs",
		"dev:web": "pnpm --filter @prime-agent/web dev",
		"build:web:release": "pnpm --filter @prime-agent/web build && pnpm --filter @prime-agent/web run check:bundle && node scripts/build-web-release.mjs",
		"check:rendering": "pnpm --filter @prime-agent/web-design run check:all",
		"check:web": "pnpm -r --if-present typecheck",
		"check:web:release": "node scripts/check-web-release.mjs",
		"test:web": "pnpm -r --if-present test",
		"test": "pnpm -r --if-present test",
		"release:pack": "pnpm --dir packages/fleet-web pack --pack-destination ../..",
		"prepare": "husky"
	},
	"devDependencies": {
		"@babel/parser": "7.29.8",
		"@biomejs/biome": "2.5.5",
		"@changesets/cli": "3.0.1",
		"@types/node": "^22.20.1",
		"@typescript/native-preview": "7.0.0-dev.20260120.1",
		"agentation-mcp": "1.2.0",
		"esbuild": "0.28.1",
		"husky": "^9.1.7",
		"jiti": "^2.7.0",
		"shx": "^0.4.0",
		"tsx": "^4.23.12",
		"typescript": "^7.0.2"
	},
	"engines": {
		"node": ">=22.12.0"
	}
}
