{
	"name": "fleet-prime",
	"version": "0.1.0",
	"private": true,
	"description": "Fleet Prime workspace UI for a pinned upstream Prime Agent runtime.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Qredence/fleet-prime-agent.git"
	},
	"type": "module",
	"bin": {
		"fleet-agent": "./packages/fleet-prime/bin/fleet-prime.mjs",
		"fleet-prime": "./packages/fleet-prime/bin/fleet-prime.mjs"
	},
	"workspaces": [
		"packages/fleet-prime"
	],
	"scripts": {
		"build": "npm run build:web:release",
		"check": "npm run check:runtime && biome check --write --error-on-warnings . && npm run check:installer && npm run check:rendering && npm run check:web",
		"check:runtime": "node scripts/check-prime-agent-runtime.mjs",
		"check:installer": "node scripts/check-source-installer.mjs --static",
		"test:source-installer": "node scripts/check-source-installer.mjs --smoke",
		"check:browser-smoke": "node scripts/check-browser-smoke.mjs",
		"dev:web": "pnpm --dir web --filter @prime-agent/web dev",
		"build:web:release": "pnpm --dir web --filter @prime-agent/web build && node scripts/build-web-release.mjs",
		"check:rendering": "pnpm --dir web --filter @prime-agent/web-design run check:message-identities && pnpm --dir web --filter @prime-agent/web-design run check:openui",
		"check:web": "pnpm --dir web run typecheck",
		"check:web:release": "node scripts/check-web-release.mjs",
		"test:web": "pnpm --dir web test",
		"test": "pnpm --dir web test",
		"release:pack": "npm pack ./packages/fleet-prime",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@types/node": "^22.10.5",
		"@typescript/native-preview": "7.0.0-dev.20260120.1",
		"esbuild": "0.28.1",
		"husky": "^9.1.7",
		"jiti": "^2.7.0",
		"shx": "^0.4.0",
		"tsx": "^4.23.1",
		"typescript": "^7.0.2"
	},
	"engines": {
		"node": ">=22.8.0"
	},
	"dependencies": {},
	"overrides": {
		"rimraf": "6.1.2",
		"gaxios": {
			"rimraf": "6.1.2"
		},
		"shell-quote": "^1.10.0"
	}
}
