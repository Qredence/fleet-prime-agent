#!/bin/sh

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$STAGED_FILES" ]; then
	exit 0
fi

echo "Running Biome on staged files..."
pnpm exec biome check --write --staged --error-on-warnings --no-errors-on-unmatched
if [ $? -ne 0 ]; then
	echo "Biome checks failed. Please fix the errors before committing."
	exit 1
fi

printf '%s\n' "$STAGED_FILES" | while IFS= read -r file; do
	if [ -f "$file" ]; then
		git add -- "$file"
	fi
done

echo "Staged files passed Biome. Run pnpm run check before opening a pull request."
