{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"tabWidth": 3,
	"printWidth": 120,
	"singleQuote": false,
	"jsxSingleQuote": false,
	"quoteProps": "as-needed",
	"trailingComma": "all",
	"semi": true,
	"arrowParens": "always",
	"bracketSameLine": false,
	"bracketSpacing": true,
	"sortPackageJson": false,
	"ignorePatterns": [
		"**/node_modules/**/*",
		"**/test-sessions.ts",
		"**/models.generated.ts",
		"**/routeTree.gen.ts",
		".worktrees",
		".claude/worktrees"
	]
}
