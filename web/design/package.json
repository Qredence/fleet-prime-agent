{
  "name": "@prime-agent/web-design",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./components/fleet-pi/*": "./src/components/fleet-pi/*",
    "./components/agents/*": "./src/components/agents/*",
    "./components/openui/*": "./src/components/openui/*",
    "./components/*": "./src/components/*",
    "./lib/canvas-utils": "./src/lib/canvas-utils.ts",
    "./lib/ease": "./src/lib/ease.ts",
    "./lib/favicon": "./src/lib/favicon.ts",
    "./lib/horizontal-resize": "./src/lib/horizontal-resize.ts",
    "./lib/hooks/*": "./src/lib/hooks/*",
    "./lib/workspace-path-nav": "./src/lib/workspace-path-nav.ts",
    "./lib/layout-constants": "./src/lib/layout-constants.ts",
    "./lib/notify": "./src/lib/notify.ts",
    "./lib/utils": "./src/lib/utils.ts",
    "./lib/springs": "./src/lib/springs.ts",
    "./lib/shimmer-styles": "./src/lib/shimmer-styles.ts",
    "./lib/ui-preferences": "./src/lib/ui-preferences.ts",
    "./lib/pi/chat-helpers": "./src/lib/pi/chat-helpers.ts",
    "./lib/pi/*": "./src/lib/pi/*",
    "./hooks/*": "./src/hooks/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate:openui-contract": "tsx scripts/generate-openui-contract.ts",
    "check:openui-contract": "tsx scripts/generate-openui-contract.ts --check",
    "check:message-identities": "tsx scripts/message-turn-identity-check.tsx",
    "check:openui": "pnpm run check:openui-contract && tsx scripts/openui-render-check.tsx",
    "check:agent-plan-contract": "tsx scripts/agent-plan-contract-check.ts",
    "check:components": "tsx scripts/component-contract-check.ts"
  },
