{
  "$schema": "https://react.doctor/schema/config.json",
  "ignore": {
    "files": [
      "**/prime-agent-visualization.html"
    ],
    "overrides": [
      {
        "files": ["src/components/openui/openui-library.tsx", "src/components/openui/charts.tsx"],
        "rules": [
          "react-doctor/no-multi-component-file",
          "react-doctor/no-multi-comp",
          "react-doctor/prefer-dynamic-import",
          "react-doctor/no-array-index-as-key"
        ]
      },
      {
        "files": ["src/lib/pi/use-pi-chat.ts", "src/lib/hooks/use-proximity-hover.ts"],
        "rules": ["react-doctor/effect-needs-cleanup"]
      },
      {
        "files": ["src/components/qredence-ui/panels/config-panel/sections/add-models-dialog.tsx"],
        "rules": ["react-doctor/js-set-map-lookups"]
      },
      {
        "files": ["src/components/qredence-ui/panels/workspace/workspace-panel.tsx"],
        "rules": [
          "react-doctor/no-adjust-state-on-prop-change",
          "react-doctor/exhaustive-deps",
          "react-doctor/no-loading-flag-reset-outside-finally"
        ]
      },
      {
        "files": ["src/components/ui/chart.tsx", "src/components/openui/data.tsx"],
        "rules": ["react-doctor/prefer-dynamic-import"]
      },
      {
        "files": ["src/components/qredence-ui/chat/message/message-turns.tsx"],
        "rules": [
          "react-doctor/no-many-boolean-props",
          "react-doctor/no-array-index-as-key"
        ]
      },
      {
        "files": [
          "src/components/qredence-ui/chat/composer/input/mode-selector.tsx",
          "src/components/qredence-ui/chat/thinking/session-reasoning-panel.tsx"
        ],
        "rules": ["deslop/unused-file"]
      },
      {
        "files": [
          "src/lib/pi/plan-state.ts",
          "src/components/qredence-ui/chat/composer/composer-menu.tsx",
          "src/components/qredence-ui/chrome/tokens.ts",
          "src/components/qredence-ui/motion/action-swap-roll.tsx",
          "src/lib/range.ts",
          "src/lib/surfaces.tsx"
        ],
        "rules": ["deslop/unused-export"]
      },
      {
        "files": ["src/components/qredence-ui/layout/ai-sidebar.tsx"],
        "rules": [
          "react-doctor/no-render-prop-children",
          "react-doctor/no-pass-live-state-to-parent",
          "react-doctor/no-pass-data-to-parent",
          "react-doctor/no-giant-component"
        ]
      },
      {
        "files": ["src/components/qredence-ui/layout/session-sidebar/project-list.tsx"],
        "rules": ["react-doctor/no-render-prop-children"]
      },
      {
        "files": ["src/components/qredence-ui/layout/session-sidebar/view-model.tsx"],
        "rules": [
          "react-doctor/no-pass-live-state-to-parent",
          "react-doctor/no-pass-data-to-parent"
        ]
      },
      {
        "files": [
          "src/components/qredence-ui/tools/file-diff.tsx",
          "src/components/qredence-ui/tools/todo-list.tsx",
          "src/components/qredence-ui/tools/tool-approval.tsx",
          "src/components/qredence-ui/tools/tool-result.tsx"
        ],
        "rules": [
          "react-doctor/no-adjust-state-on-prop-change",
          "react-doctor/no-pass-data-to-parent"
        ]
      },
      {
        "files": [
          "src/components/qredence-ui/chat/composer/input-bar-state.tsx",
          "src/components/qredence-ui/panels/workspace/artifacts-panel.tsx"
        ],
        "rules": ["react-doctor/no-adjust-state-on-prop-change"]
      },
      {
        "files": ["src/components/qredence-ui/panels/config-panel/sections/use-oauth-login-flow.ts"],
        "rules": [
          "react-doctor/no-set-state-after-await-in-effect",
          "react-doctor/no-loading-flag-reset-outside-finally"
        ]
      },
      {
        "files": ["src/components/qredence-ui/layout/project-folder.tsx"],
        "rules": ["react-doctor/prefer-html-dialog"]
      },
      {
        "files": [
          "src/components/qredence-ui/chat/composer/composer-menu.tsx",
          "src/components/qredence-ui/chat/thinking/reasoning-panel.tsx",
          "src/components/qredence-ui/chat/thinking/thinking-indicator.tsx"
        ],
        "rules": [
          "react-doctor/no-transition-all",
          "react-doctor/no-array-index-as-key"
        ]
      },
      {
        "files": [
          "src/components/qredence-ui/tools/agent-disclosure.tsx",
          "src/components/qredence-ui/tools/tool-result.tsx",
          "src/components/qredence-ui/motion/file-tree.tsx"
        ],
        "rules": [
          "react-doctor/use-lazy-motion",
          "react-doctor/prefer-module-scope-static-value",
          "react-doctor/motion-animate-presence-must-outlive-child"
        ]
      },
      {
        "files": [
          "src/components/qredence-ui/chat/composer/prompt-input.tsx"
        ],
        "rules": [
          "react-doctor/motion-animate-presence-must-outlive-child"
        ]
      },
      {
        "files": [
          "package.json"
        ],
        "rules": [
          "deslop/unused-dependency"
        ]
      },
      {
        // shadcn-style primitives and Qredence UI components keep their
        // upstream layout: variants, contexts, and helpers export alongside
        // components, reachable through the ./components/ui/* and
        // ./components/qredence-ui/* wildcard package exports.
        "files": [
          "src/components/ui/badge.tsx",
          "src/components/ui/button.tsx",
          "src/components/ui/chart.tsx",
          "src/components/ui/tabs.tsx",
          "src/components/ui/toast.tsx",
          "src/components/qredence-ui/chat/markdown/markdown.tsx",
          "src/components/qredence-ui/chat/message/message-toolbar.tsx",
          "src/components/qredence-ui/chat/message/message-turns.tsx",
          "src/components/qredence-ui/tools/mcp-tool.tsx",
          "src/components/qredence-ui/chat/composer/composer-menu.tsx",
          "src/components/qredence-ui/tools/session-agent-plan.tsx"
        ],
        "rules": ["react-doctor/only-export-components"]
      },
      {
        // right-panel-registry.tsx is a definition registry by design: each
        // named content wrapper pairs a lazy panel with its Suspense
        // fallback, mirroring the openui-library waiver rationale.
        "files": ["src/components/qredence-ui/layout/right-panel-registry.tsx"],
        "rules": [
          "react-doctor/no-multi-component-file",
          "react-doctor/no-multi-comp"
        ]
      },
      {
        // False positive — the session-bootstrap effect is single-run
        // (initializedRef) and re-checks controller.signal.aborted after
        // every await boundary; the detector cannot follow AbortController
        // cancellation proofs (same rationale as use-oauth-login-flow).
        "files": ["src/lib/pi/use-pi-chat.ts"],
        "rules": ["react-doctor/no-set-state-after-await-in-effect"]
      },
      {
        // Restored from the pre-restructure root config (dropped in the
        // component regroup): exports are reachable through the wildcard
        // package exports and reserved for direct consumers or future UI
        // surfaces; the detector only sees current in-workspace imports.
        // icons.tsx is waived under the same registry rationale.
        "files": [
          "src/components/qredence-ui/tools/citations.tsx",
          "src/components/qredence-ui/chat/icons.tsx",
          "src/components/qredence-ui/chat/message/message-bubble.tsx",
          "src/components/qredence-ui/chat/message/message.tsx",
          "src/components/qredence-ui/tools/tool-approval.tsx"
        ],
        "rules": ["deslop/unused-export"]
      }
    ]
  }
}
