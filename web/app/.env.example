# Local development flags only. Provider keys belong in Settings → Providers,
# not in this file. Copy values you need into `.env.local` in this directory
# (`web/app`), which Vite loads via `envDir`.

# Disable the Agentation overlay (Playwright and other interaction tests).
# VITE_FLEET_DISABLE_AGENTATION=1

# Override the chat adapter origin when the browser is not same-origin.
# VITE_FLEET_PI_CHAT_RUNTIME_URL=http://127.0.0.1:3000

# Verbose PrimeBridge logs in the server process.
# PRIME_BRIDGE_DEBUG=1
