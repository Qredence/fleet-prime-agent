# Local development flags only. Provider keys belong in Settings → Providers,
# not in this file. Copy values you need into `.env.local` in this directory
# (`web/app`), which Vite loads via `envDir`.

# Disable the Agentation overlay (Playwright and other interaction tests).
# VITE_FLEET_DISABLE_AGENTATION=1

# Override the chat adapter origin when the browser is not same-origin.
# VITE_FLEET_PI_CHAT_RUNTIME_URL=http://127.0.0.1:3000

# Verbose PrimeBridge logs in the server process.
# PRIME_BRIDGE_DEBUG=1

# Optional composer command routing (TypeSafe / System One). Server-process
# only — never prefix with VITE_, and never surface the value in browser state.
# Setting the key makes the feature available; it still stays off until it is
# enabled in Settings → Chat, because messages you send are classified by a
# hosted service. Leaving the key unset disables it entirely.
# TYPESAFE_API_KEY=...
# TYPESAFE_MODEL=jev-latest
# TYPESAFE_INTENT_TIMEOUT_MS=1500
# Kitchen-sink kill switch, even with a key present.
# FLEET_TYPESAFE_ENABLED=0
