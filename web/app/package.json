{
  "name": "@qredence/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "preview": "vite preview",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "bench": "vitest bench --config vitest.bench.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "generate:openui-contract": "tsx scripts/generate-openui-contract.ts",
    "check:openui-contract": "tsx scripts/generate-openui-contract.ts --check",
    "check:message-identities": "tsx scripts/message-turn-identity-check.tsx",
    "check:openui": "tsx scripts/generate-openui-contract.ts --check && tsx scripts/openui-render-check.tsx",
    "check:openui-render": "tsx scripts/openui-render-check.tsx",
    "check:components": "tsx scripts/component-contract-check.ts",
    "check:all": "node scripts/render-checks.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@openuidev/dashboard-library": "^0.0.2",
    "@openuidev/observability-cloud": "^0.0.3",
    "@openuidev/react-headless": "^0.18.6",
    "@openuidev/react-lang": "^1.1.0",
    "@openuidev/react-ui": "^0.18.6",
    "@prime-agent/web-protocol": "workspace:*",
    "@prime-agent/web-server": "workspace:*",
    "@streamdown/code": "^2.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.5",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "0.5.2",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "recharts": "3.10.1",
    "shadcn": "4.23.0",
    "shiki": "4.6.0",
    "streamdown": "^2.7.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "agentation": "3.1.2",
    "happy-dom": "21.0.4",
    "oxc-transform-react": "0.157.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "8.3.6",
    "vitest": "^5.1.0"
  }
}
