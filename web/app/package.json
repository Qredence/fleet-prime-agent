{
  "name": "@qredence/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "preview": "vite preview",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "bench": "vitest bench --config vitest.bench.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "generate:openui-contract": "tsx scripts/generate-openui-contract.ts",
    "check:openui-contract": "tsx scripts/generate-openui-contract.ts --check",
    "check:message-identities": "tsx scripts/message-turn-identity-check.tsx",
    "check:openui": "pnpm run check:openui-contract && pnpm run check:openui-render",
    "check:openui-render": "tsx scripts/openui-render-check.tsx",
    "check:agent-plan-contract": "tsx scripts/agent-plan-contract-check.ts",
    "check:components": "tsx scripts/component-contract-check.ts && tsx scripts/component-contract-fixtures-check.ts",
    "check:registries": "tsx scripts/component-registry-check.ts",
    "check:all": "node scripts/render-checks.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@openuidev/react-lang": "^0.2.15",
    "@openuidev/react-ui": "^0.13.10",
    "@pierre/diffs": "^1.4.1",
    "@prime-agent/web-protocol": "workspace:*",
    "@prime-agent/web-server": "workspace:*",
    "@streamdown/code": "^1.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.36",
    "@tanstack/react-start": "^1.168.49",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "0.3.0",
    "lucide-react": "^1.44.0",
    "motion": "^13.2.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.5",
    "recharts": "3.10.1",
    "shadcn": "4.21.0",
    "shiki": "4.4.3",
    "streamdown": "^2.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.12",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "agentation": "3.0.2",
    "happy-dom": "20.14.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
